<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<QtExportAs>metadata</QtExportAs>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <QtBridgePackagePrefix>QtGroup.Qt.Bridge.CSharp</QtBridgePackagePrefix>
    <QtBridgeTemplateArch Condition="'$(QtBridgeTemplateArch)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</QtBridgeTemplateArch>
    <QtBridgeTemplateArch Condition="'$(QtBridgeTemplateArch)' == 'X64'">x64</QtBridgeTemplateArch>
    <QtBridgeTemplateArch Condition="'$(QtBridgeTemplateArch)' == 'Arm64'">arm64</QtBridgeTemplateArch>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</QtBridgeTemplateRid>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-$(QtBridgeTemplateArch)</QtBridgeTemplateRid>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-$(QtBridgeTemplateArch)</QtBridgeTemplateRid>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-$(QtBridgeTemplateArch)</QtBridgeTemplateRid>
    <QtBridgePackageId>$(QtBridgePackagePrefix).$(QtBridgeTemplateRid)</QtBridgePackageId>
  </PropertyGroup>

  <ItemGroup Condition="'$(QtBridgeTemplateRid)' == 'win-x64'&#xD;&#xA;                    or '$(QtBridgeTemplateRid)' == 'win-arm64'&#xD;&#xA;                    or '$(QtBridgeTemplateRid)' == 'linux-x64'&#xD;&#xA;                    or '$(QtBridgeTemplateRid)' == 'osx-x64'&#xD;&#xA;                    or '$(QtBridgeTemplateRid)' == 'osx-arm64'">
    <PackageReference Include="$(QtBridgePackageId)" Version="0.5.0" />
  </ItemGroup>

  <Target Name="EnsureSupportedQtBridgePlatform" BeforeTargets="Restore;Build" Condition="'$(QtBridgeTemplateRid)' != 'win-x64'&#xD;&#xA;                  and '$(QtBridgeTemplateRid)' != 'win-arm64'&#xD;&#xA;                  and '$(QtBridgeTemplateRid)' != 'linux-x64'&#xD;&#xA;                  and '$(QtBridgeTemplateRid)' != 'osx-x64'&#xD;&#xA;                  and '$(QtBridgeTemplateRid)' != 'osx-arm64'">
    <Error Text="Qt Bridge for C# currently supports win-x64, win-arm64, linux-x64, osx-x64, and osx-arm64. Selected RID: '$(QtBridgeTemplateRid)'." />
  </Target>

  <ItemGroup>
    <None Include="Main.qml" />
    <Compile Include="DummyViewModel.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="SnapserverBootstrap.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maestro.Core\Maestro.Core.csproj" />
  </ItemGroup>

  <!-- Shared Amplify UI components (also used by the amp), imported in QML with "import Amplify". -->
  <PropertyGroup>
    <AmplifySharedQmlDir>..\..\shared\qml\Amplify\</AmplifySharedQmlDir>
  </PropertyGroup>

  <ItemGroup>
    <Qml Include="$(AmplifySharedQmlDir)*.qml" IsAmplifyShared="true" />
    <None Include="$(AmplifySharedQmlDir)icons\*.svg" Link="Amplify\icons\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Qt Bridge names a QML module after the file's folder inside the project, which breaks for
    files outside it. Put the shared files in the "Amplify" module instead.
  -->
  <Target Name="UseAmplifyQmlModule" AfterTargets="QtBridgeSetupQml">
    <ItemGroup>
      <QmlModule Remove="@(Qml->WithMetadataValue('IsAmplifyShared', 'true')->Metadata('Uri'))" />
      <Qml Condition="'%(Qml.IsAmplifyShared)' == 'true'">
        <SourceDir>Amplify/</SourceDir>
        <Uri>Amplify</Uri>
        <JsonModulePath>Amplify/</JsonModulePath>
        <JsonResourceUrl>qrc:/qt/qml/Amplify/%(Filename)%(Extension)</JsonResourceUrl>
      </Qml>
      <QmlModule Include="Amplify">
        <IsRoot>false</IsRoot>
        <SourceDir>Amplify/</SourceDir>
      </QmlModule>
    </ItemGroup>
  </Target>

  <!--
    Qt Bridge writes qmldir without the "singleton" keyword, so QML files with
    "pragma Singleton" (Theme, Icons) come out undefined. Add the keyword after build.
  -->
  <UsingTask TaskName="MarkQmlSingletons" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputDir ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
foreach (var qmldir in Directory.GetFiles(OutputDir, "qmldir", SearchOption.AllDirectories))
{
    var dir = Path.GetDirectoryName(qmldir);
    var lines = File.ReadAllLines(qmldir).Select(line =>
    {
        var parts = line.Split(' ');
        var isQmlType = parts.Length == 3 && parts[2].EndsWith(".qml");
        if (!isQmlType)
            return line;
        var file = Path.Combine(dir, parts[2]);
        return File.Exists(file) && File.ReadLines(file).Any(l => l.Trim() == "pragma Singleton")
            ? "singleton " + line
            : line;
    }).ToArray();
    File.WriteAllLines(qmldir, lines);
}
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="MarkQmlSingletons" AfterTargets="Build">
    <MarkQmlSingletons OutputDir="$(OutDir)" />
  </Target>

</Project>
